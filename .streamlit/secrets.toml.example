# Copy into Streamlit Cloud: app menu -> Settings -> Secrets. Paste the
# contents (not the filename). Locally, save as .streamlit/secrets.toml.
#
# Streamlit Cloud's disk is EPHEMERAL. Without these SMTP settings,
# submissions are lost when the container restarts.

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_SECURE = "false"
SMTP_USER = "you@gmail.com"
SMTP_PASS = "your-16-char-app-password"
NOTIFY_FROM = "Third Self Project <you@gmail.com>"
NOTIFY_TO = "submissions@thirdselfproject.org"

# Who can open /?admin=1
[editors]
mira = "generate-a-long-random-password"
rob = "generate-a-different-one"
