# Copy to .env and edit. Everything here is optional for local use, but
# ADMIN_USERS is required before /admin will answer over the network.

PORT=3000

# --- Who can read the inbox at /admin ---
# One "name:password" pair per editor, comma-separated. Each person gets their
# own login, so you can remove one without resetting everyone else's.
# Generate passwords with:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_USERS=mira:CHANGE-ME,rob:CHANGE-ME-TOO

# Single-editor shortcut, kept for convenience. If set it is added to the list above.
# ADMIN_USER=editor
# ADMIN_PASSWORD=

# --- Storage ---
# Absolute path to a PERSISTENT disk in production. Leave unset to use ./data
# locally. On hosts with ephemeral filesystems, a redeploy wipes anything that
# is not on a mounted volume — that would mean losing submissions.
# DATA_DIR=/data

# --- Limits ---
MAX_UPLOAD_MB=10
# Accepted submissions per IP per hour. Rejected attempts don't count.
RATE_LIMIT_PER_HOUR=5
# Set to 1 when running behind exactly one reverse proxy (Render, Railway,
# Fly, Cloudflare, nginx), so rate limiting sees real client IPs.
TRUST_PROXY=0

# --- Optional email notification ---
# Leave SMTP_HOST blank to disable email entirely; submissions are still
# saved to disk and readable at /admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM="Third Self Project <submissions@thirdselfproject.org>"
NOTIFY_TO=
